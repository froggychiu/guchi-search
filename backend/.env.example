# Database (Railway provides this automatically)
GUCHI_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/guchi_search
GUCHI_DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/guchi_search

# Meilisearch
GUCHI_MEILISEARCH_URL=http://localhost:7700
GUCHI_MEILISEARCH_API_KEY=

# OpenAI API Key (for Whisper transcription)
GUCHI_OPENAI_API_KEY=sk-your-key-here

# RSS Feed
GUCHI_RSS_FEED_URL=https://feeds.soundon.fm/podcasts/ecd31076-d12d-46dc-ba11-32d24b41cca5.xml

# Ingest / admin secret. Also triggers maintenance and replace-text, so it is
# never sent to a browser — the admin UI exchanges it for a session token.
GUCHI_INGEST_SECRET=

# Shared with the frontend only (as INTERNAL_API_TOKEN there). Exempts
# server-side rendering from the public read rate limits, since every rendered
# page reaches the API from a single container IP. Grants nothing else.
# Leave empty to disable the bypass.
GUCHI_INTERNAL_TOKEN=
